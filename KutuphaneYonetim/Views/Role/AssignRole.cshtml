@using KutuphaneYonetim.ViewModels
@model List<AssignRoleViewModel>

<div class="row">
    <div class="col-md-6 offset-md-3">
        <h2>Rol Atama</h2>

        <form asp-action="AssignRole" asp-route-userId="@ViewBag.userId" method="post">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="mb-3 form-check">
                    <input type="hidden" asp-for="@Model[i].Roles[0].RoleName" />

                    <input type="checkbox"
                           asp-for="@Model[i].Roles[0].IsSelected"
                           class="form-check-input"
                           id="role_@i" />

                    <label class="form-check-label" for="role_@i">
                        @Model[i].Roles[0].RoleName
                    </label>
                </div>
            }

            <div class="form-group mt-3">
                <input type="submit" value="Rol Ata" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>