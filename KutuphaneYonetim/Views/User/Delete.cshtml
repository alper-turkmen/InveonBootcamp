@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Kullanıcı Silme";
}

<h1>Kullanıcı Sil</h1>

<p><strong>Kullanıcı Adı:</strong> @Model.UserName</p>
<p><strong>E-posta:</strong> @Model.Email</p>

<p>Bu kullanıcıyı silmek istediğinize emin misiniz?</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="List" class="btn btn-secondary">İptal</a>
</form>